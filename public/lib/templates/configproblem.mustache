{{!
    @template core/error

    Template for displaying an error message during installation

    Example context (json):
    {
        "dir": "rtl",
        "css": "https://moodle.org/public/install/css.php",
        "problemdescription": "Short text about the problem"
    }
}}

<!DOCTYPE html>
<html dir="{{dir}}">
    <head>
        <link rel="shortcut icon" href="theme/clean/pix/favicon.ico">
        <link rel="stylesheet" type="text/css" href="{{css}}">
        <title>{{#str}}installation, install{{/str}} | Moodle</title>
        <meta name="robots" content="noindex">
        <meta http-equiv="content-type" content="text/html; charset=UTF-8">
    </head>
    <body class="notloggedin">
        <div id="page" class="mt-0 container stage">
            <div id="page-header">
                <div id="header" class=" clearfix">
                    <h1 class="headermain">{{#str}}installation, install{{/str}}</h1>
                    <div class="headermenu">&nbsp;</div>
                </div>
                <div class="bg-light p-3 mb-3"><h3 class="m-0">{{#str}}configuration, install{{/str}}</h3></div>
            </div>
            <!-- END OF HEADER -->
            <div id="installdiv">
                <h2>{{#str}}webservernotconfigured, install{{/str}}</h2>
                <div class="alert alert-warning">
                    {{{webserverconfigproblemdescription}}}
                </div>
            </div>
            <div id="page-footer">
                <div class="sitelink">
                    <a title="Moodle" href="http://docs.moodle.org/en/Administrator_documentation">
                        <img src="../pix/moodlelogo.png" alt="{{#str}}moodlelogo, core{{/str}}">
                    </a>
                </div>
            </div>
        </div>
    </body>
</html>
